# Public canonical site URL. Replace with the verified production origin before launch.
NEXT_PUBLIC_SITE_URL=https://example.com

# Set true only when a trusted reverse proxy sanitizes X-Forwarded-For and
# direct access to the app server is blocked. Otherwise rate limits share one key.
TRUST_X_FORWARDED_FOR=false

# Contact email provider (server-only secrets/configuration).
RESEND_API_KEY=re_your_key_here
CONTACT_TO_EMAIL=hello@your-verified-domain.com
CONTACT_FROM_EMAIL=ATLaS Website <website@your-verified-domain.com>

# Private admin dashboard. Replace every placeholder with a unique secret value.
ADMIN_USERNAME=change-this-admin-name
ADMIN_PASSWORD=change-this-to-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Neon PostgreSQL Database (recommended for serverless & production).
# Copy the connection string from your Neon project. Keep the real value in .env.local.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional SQLite database file location (used as fallback when DATABASE_URL is not set).
# DATABASE_PATH=./data/atlas.sqlite
